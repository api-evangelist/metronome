            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity\": \"<string>\",\n  \"entity_id\": \"<uuid>\",\n  \"keys\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
