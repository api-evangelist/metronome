                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"entity\": \"customer\",\n  \"entity_id\": \"99594816-e8a5-4bca-be21-8d1de0f45120\",\n  \"custom_fields\": {\n    \"x_account_id\": \"KyVnHhSBWl7eY2bl\"\n  }\n}",
                  "options": {
