        {
          "id": "83a8e37d-a0b8-4f93-a166-7703964b982d",
          "name": "Set custom field values",
          "request": {
            "name": "Set custom field values",
            "description": {
              "content": "Sets custom field values on a specific Metronome entity instance. Overwrites existing values for matching keys while preserving other fields. All updates are transactional—either all values are set or none are. Custom field values are limited to 200 characters each.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "customFields",
                "setValues"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity\": \"<string>\",\n  \"entity_id\": \"<uuid>\",\n  \"custom_fields\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "89ead5a2-dafc-442f-a69a-5ff99397e137",
