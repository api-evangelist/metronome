        {
          "id": "a51a9187-fd33-43a8-9219-bac0d409f7b4",
          "name": "Delete custom fields",
          "request": {
            "name": "Delete custom fields",
            "description": {
              "content": "Remove specific custom field values from a Metronome entity instance by specifying the field keys to delete. Use this endpoint to clean up unwanted custom field data while preserving other fields on the same entity. Requires the entity type, entity ID, and array of keys to remove.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "customFields",
                "deleteValues"
