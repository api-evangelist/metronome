{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metronome Alerts Integrations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Log events from integration services to Cloudwatch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.metronome.com/v1/integrations/log",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Log events from integration services to Cloudwatch"
        }
      ]
    }
  ],
  "bundled": true
}